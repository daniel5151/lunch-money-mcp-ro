# ==============================================================================
# Lunch Money MCP Server Configuration
# ==============================================================================

# Required: Your Lunch Money developer API access token
# Obtain from: https://my.lunchmoney.dev/developers
LUNCHMONEY_API_KEY="your_lunch_money_api_key_here"

# Optional: Override Lunch Money API base URL (defaults to production https://api.lunchmoney.dev/v2)
# LM_API_BASE_URL="https://api.lunchmoney.dev/v2"

# ==============================================================================
# HTTP Hosting & Network Settings
# ==============================================================================

# Mode: 'http' for web hosting with OAuth, or 'stdio' for CLI/desktop use
MCP_MODE="http"

# Internal bind port and address
MCP_PORT="3000"
MCP_HOST="0.0.0.0"

# Public HTTPS base URL where this server is reached behind Nginx
# For local testing: http://localhost:3000
MCP_BASE_URL="https://lm-mcp-ro.example.com"

# ==============================================================================
# Gemini Web OAuth Client Credentials
# ==============================================================================
# You invent these values yourself and enter them into Gemini Web
# under "Show more" / "Advanced features" when adding the custom app:
MCP_OAUTH_CLIENT_ID="gemini-client"
MCP_OAUTH_CLIENT_SECRET="generate-a-secure-random-client-secret-here"

# ==============================================================================
# JWT Signing Key
# ==============================================================================
# Secret key used to sign stateless access and refresh tokens.
# Change this key to instantly invalidate/revoke all previously issued tokens.
MCP_JWT_SECRET="generate-a-random-64-character-hex-string-here"
